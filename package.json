{
  "name": "kysely-pglite",
  "version": "0.6.1",
  "description": "Kysely dialect for @electric-sql/pglite",
  "repository": "https://github.com/dnlsandiego/kysely-pglite",
  "keywords": [
    "@electric-sql/pglite",
    "kysely",
    "postgresql",
    "wasm",
    "database",
    "sql"
  ],
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@8.14.2",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build",
    "format": "prettier ./src --write",
    "test": "vitest"
  },
  "files": [
    "dist",
    "bin/run.js",
    "bin/run.cmd"
  ],
  "imports": {
    "#*": {
      "default": "./dist/*"
    }
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "kysely": "https://pkg.pr.new/kysely-org/kysely/kysely@2b7007e"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.14",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "type-fest": "^4.38.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@oclif/core": "^4.2.10",
    "@repeaterjs/repeater": "^3.0.6",
    "@sindresorhus/is": "^7.0.1",
    "chokidar": "^4.0.3",
    "consola": "^3.4.2",
    "fs-extra": "^11.3.0",
    "jiti": "^2.4.2",
    "kysely-codegen": "^0.18.3",
    "radash": "^12.1.0",
    "tinyglobby": "^0.2.12"
  },
  "bin": {
    "kysely-pglite": "./bin/run.js",
    "kpg": "./bin/run.js"
  },
  "oclif": {
    "binAliases": [
      "kysely-pglite",
      "kpg"
    ],
    "commands": {
      "strategy": "single",
      "target": "./dist/cli.js"
    },
    "dirname": "kysely-pglite",
    "topicSeparator": " "
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "glob": "*",
      "inflight": "*"
    }
  },
  "author": "Daniel Sandiego"
}