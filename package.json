{
  "name": "@jadejr/kysely-pglite",
  "version": "1.0.3",
  "description": "Kysely dialect for @electric-sql/pglite (temporary fork https://github.com/dnlsandiego/kysely-pglite)",
  "repository": "https://github.com/jadejr/kysely-pglite",
  "keywords": [
    "@electric-sql/pglite",
    "kysely",
    "postgresql",
    "wasm",
    "database",
    "sql"
  ],
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build",
    "format": "prettier ./src --write",
    "test": "vitest"
  },
  "files": [
    "dist",
    "bin/run.js",
    "bin/run.cmd"
  ],
  "imports": {
    "#*": {
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./codegen": {
      "import": {
        "types": "./dist/codegen.d.ts",
        "default": "./dist/codegen.js"
      }
    }
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "kysely": "^0.28"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.16.5",
    "kysely": "^0.28.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "type-fest": "^4.41.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@oclif/core": "^4.5.1",
    "@repeaterjs/repeater": "^3.0.6",
    "@sindresorhus/is": "^7.0.2",
    "chokidar": "^4.0.3",
    "consola": "^3.4.2",
    "fs-extra": "^11.3.0",
    "jiti": "^2.4.2",
    "kysely-codegen": "^0.18.5",
    "radash": "^12.1.1",
    "tinyglobby": "^0.2.14"
  },
  "bin": {
    "kysely-pglite": "./bin/run.js",
    "kpg": "./bin/run.js"
  },
  "oclif": {
    "binAliases": [
      "kysely-pglite",
      "kpg"
    ],
    "commands": {
      "strategy": "single",
      "target": "./dist/cli.js"
    },
    "dirname": "kysely-pglite",
    "topicSeparator": " "
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "glob": "*",
      "inflight": "*"
    }
  },
  "author": "Daniel Sandiego",
  "publishConfig": {
    "access": "public"
  }
}