{
  "name": "@jadejr/kysely-pglite",
  "version": "2.0.0",
  "description": "Kysely dialect for @electric-sql/pglite (temporary fork https://github.com/dnlsandiego/kysely-pglite)",
  "repository": "https://github.com/jadejr/kysely-pglite",
  "keywords": [
    "@electric-sql/pglite",
    "kysely",
    "postgresql",
    "wasm",
    "database",
    "sql"
  ],
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build",
    "format": "prettier ./src --write",
    "test": "vitest"
  },
  "files": [
    "dist",
    "bin/run.js",
    "bin/run.cmd"
  ],
  "imports": {
    "#*": {
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "kysely": "^0.28"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.16.5",
    "kysely": "^0.28.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sindresorhus/is": "^7.0.2",
    "fs-extra": "^11.3.0"
  },
  "author": "Daniel Sandiego",
  "publishConfig": {
    "access": "public"
  }
}
